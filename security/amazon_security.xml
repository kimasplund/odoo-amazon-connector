<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ========================== -->
        <!-- Amazon Module Category     -->
        <!-- ========================== -->
        <record id="module_category_amazon" model="ir.module.category">
            <field name="name">Amazon Connector</field>
            <field name="description">Manage Amazon integration, orders, products, and FBA operations.</field>
            <field name="sequence">50</field>
        </record>

        <!-- ========================== -->
        <!-- User Groups                -->
        <!-- ========================== -->

        <!-- Amazon User: Basic access for viewing and limited operations -->
        <record id="group_amazon_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_amazon"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Basic Amazon access:
                - View Amazon orders and listings
                - View FBA inventory
                - View settlement reports
                - Cannot modify configurations
            </field>
        </record>

        <!-- Amazon Manager: Full operational access -->
        <record id="group_amazon_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_amazon"/>
            <field name="implied_ids" eval="[(4, ref('group_amazon_user'))]"/>
            <field name="comment">
                Full operational access:
                - Create/edit product listings
                - Process orders and returns
                - Create FBA shipments
                - Import settlements
                - Sync inventory and pricing
                - Cannot manage accounts or credentials
            </field>
        </record>

        <!-- Amazon Admin: Full administrative access -->
        <record id="group_amazon_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_amazon"/>
            <field name="implied_ids" eval="[(4, ref('group_amazon_manager'))]"/>
            <field name="comment">
                Full administrative access:
                - Manage Amazon accounts
                - Configure SP-API credentials
                - Manage marketplace settings
                - Access all sensitive data
                - Configure cron jobs and automations
            </field>
        </record>

        <!-- ========================== -->
        <!-- Record Rules               -->
        <!-- ========================== -->

        <!-- Multi-company rule: Users can only see their company's Amazon accounts -->
        <record id="amazon_account_company_rule" model="ir.rule">
            <field name="name">Amazon Account: Multi-Company</field>
            <field name="model_id" ref="amazon_connector.model_amazon_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Multi-company rule: Orders visible per company -->
        <record id="amazon_order_company_rule" model="ir.rule">
            <field name="name">Amazon Order: Multi-Company</field>
            <field name="model_id" ref="amazon_connector.model_amazon_order"/>
            <field name="domain_force">[('account_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Multi-company rule: Product listings per company -->
        <record id="amazon_product_listing_company_rule" model="ir.rule">
            <field name="name">Amazon Product Listing: Multi-Company</field>
            <field name="model_id" ref="amazon_connector.model_amazon_product_listing"/>
            <field name="domain_force">[('account_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Multi-company rule: FBA Shipments per company -->
        <record id="amazon_fba_shipment_company_rule" model="ir.rule">
            <field name="name">Amazon FBA Shipment: Multi-Company</field>
            <field name="model_id" ref="amazon_connector.model_amazon_fba_shipment"/>
            <field name="domain_force">[('account_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Multi-company rule: Settlements per company -->
        <record id="amazon_settlement_company_rule" model="ir.rule">
            <field name="name">Amazon Settlement: Multi-Company</field>
            <field name="model_id" ref="amazon_connector.model_amazon_settlement"/>
            <field name="domain_force">[('account_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Credentials: Only admins can see credentials -->
        <record id="amazon_credential_admin_rule" model="ir.rule">
            <field name="name">Amazon Credential: Admin Only</field>
            <field name="model_id" ref="amazon_connector.model_amazon_credential"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('amazon_connector.group_amazon_admin'))]"/>
        </record>

        <!-- Credentials: Non-admins cannot see any credentials -->
        <record id="amazon_credential_user_rule" model="ir.rule">
            <field name="name">Amazon Credential: Hide from Users</field>
            <field name="model_id" ref="amazon_connector.model_amazon_credential"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('amazon_connector.group_amazon_user'))]"/>
        </record>

    </data>
</odoo>
