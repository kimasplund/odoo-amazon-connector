<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Amazon FBA Inventory Views                                    -->
    <!-- ============================================================ -->

    <!-- Tree View -->
    <record id="amazon_fba_inventory_view_tree" model="ir.ui.view">
        <field name="name">amazon.fba.inventory.tree</field>
        <field name="model">amazon.fba.inventory</field>
        <field name="arch" type="xml">
            <list string="FBA Inventory" 
                  decoration-danger="quantity_sellable == 0"
                  decoration-warning="needs_restock"
                  sample="1">
                <field name="product_id" widget="many2one_avatar"/>
                <field name="listing_id" optional="hide"/>
                <field name="amazon_sku"/>
                <field name="amazon_asin" optional="hide"/>
                <field name="amazon_fnsku" optional="hide"/>
                <field name="marketplace_id"/>
                <field name="quantity_sellable"/>
                <field name="quantity_reserved" optional="show"/>
                <field name="quantity_inbound_total" optional="show"/>
                <field name="quantity_unfulfillable" optional="show"/>
                <field name="days_of_supply" optional="show"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="amazon_fba_inventory_view_form" model="ir.ui.view">
        <field name="name">amazon.fba.inventory.form</field>
        <field name="model">amazon.fba.inventory</field>
        <field name="arch" type="xml">
            <form string="FBA Inventory">
                <sheet>
                    <widget name="web_ribbon" title="Out of Stock" bg_color="text-bg-danger" invisible="quantity_sellable > 0"/>
                    <widget name="web_ribbon" title="Needs Restock" bg_color="text-bg-warning" invisible="not needs_restock or quantity_sellable == 0"/>
                    <widget name="web_ribbon" title="Stranded" bg_color="text-bg-danger" invisible="not is_stranded"/>
                    <div class="oe_title">
                        <label for="product_id"/>
                        <h1>
                            <field name="product_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="listing_id"/>
                            <field name="amazon_sku"/>
                            <field name="amazon_asin"/>
                            <field name="amazon_fnsku"/>
                            <field name="product_name"/>
                        </group>
                        <group string="Location">
                            <field name="account_id"/>
                            <field name="marketplace_id"/>
                            <field name="fulfillment_center_id"/>
                            <field name="country_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quantities" name="quantities">
                            <group>
                                <group string="Available Stock">
                                    <field name="quantity_available"/>
                                    <field name="quantity_sellable"/>
                                    <field name="quantity_reserved"/>
                                    <field name="quantity_total"/>
                                </group>
                                <group string="Inbound Quantities">
                                    <field name="quantity_inbound_total"/>
                                    <field name="quantity_inbound_working"/>
                                    <field name="quantity_inbound_shipped"/>
                                    <field name="quantity_inbound_receiving"/>
                                </group>
                            </group>
                            <group>
                                <group string="Problem Inventory">
                                    <field name="quantity_unfulfillable"/>
                                    <field name="quantity_researching"/>
                                    <field name="is_stranded"/>
                                    <field name="stranded_reason" invisible="not is_stranded"/>
                                </group>
                                <group string="Replenishment">
                                    <field name="needs_restock"/>
                                    <field name="restock_level"/>
                                    <field name="days_of_supply"/>
                                </group>
                            </group>
                        </page>
                        <page string="Inventory Age" name="age">
                            <group>
                                <group>
                                    <field name="inventory_age_0_90"/>
                                    <field name="inventory_age_91_180"/>
                                    <field name="inventory_age_181_270"/>
                                </group>
                                <group>
                                    <field name="inventory_age_271_365"/>
                                    <field name="inventory_age_365_plus"/>
                                </group>
                            </group>
                            <group string="Storage Fees">
                                <field name="storage_type"/>
                                <field name="monthly_storage_fee" widget="monetary"/>
                                <field name="long_term_storage_fee" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Sync Info" name="sync">
                            <group>
                                <group>
                                    <field name="last_sync_date"/>
                                    <field name="last_updated"/>
                                    <field name="sync_error"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="amazon_fba_inventory_view_kanban" model="ir.ui.view">
        <field name="name">amazon.fba.inventory.kanban</field>
        <field name="model">amazon.fba.inventory</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="product_id"/>
                <field name="amazon_sku"/>
                <field name="quantity_sellable"/>
                <field name="quantity_reserved"/>
                <field name="quantity_inbound_total"/>
                <field name="needs_restock"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong class="o_kanban_record_title text-truncate" style="max-width: 200px;">
                                    <field name="product_id"/>
                                </strong>
                                <span t-if="record.needs_restock.raw_value" class="badge text-bg-warning">Restock</span>
                            </div>
                            <div class="text-muted small mb-2">
                                SKU: <field name="amazon_sku"/>
                            </div>
                            <div class="row">
                                <div class="col-4 text-center">
                                    <span class="fw-bold" t-att-class="record.quantity_sellable.raw_value == 0 ? 'text-danger' : 'text-success'">
                                        <field name="quantity_sellable"/>
                                    </span>
                                    <div class="text-muted small">Sellable</div>
                                </div>
                                <div class="col-4 text-center">
                                    <span class="fw-bold text-info"><field name="quantity_reserved"/></span>
                                    <div class="text-muted small">Reserved</div>
                                </div>
                                <div class="col-4 text-center">
                                    <span class="fw-bold text-primary"><field name="quantity_inbound_total"/></span>
                                    <div class="text-muted small">Inbound</div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Graph View -->
    <record id="amazon_fba_inventory_view_graph" model="ir.ui.view">
        <field name="name">amazon.fba.inventory.graph</field>
        <field name="model">amazon.fba.inventory</field>
        <field name="arch" type="xml">
            <graph string="Inventory Levels" type="bar" sample="1">
                <field name="marketplace_id"/>
                <field name="quantity_sellable" type="measure"/>
                <field name="quantity_reserved" type="measure"/>
                <field name="quantity_inbound_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="amazon_fba_inventory_view_pivot" model="ir.ui.view">
        <field name="name">amazon.fba.inventory.pivot</field>
        <field name="model">amazon.fba.inventory</field>
        <field name="arch" type="xml">
            <pivot string="Inventory Analysis" sample="1">
                <field name="marketplace_id" type="row"/>
                <field name="quantity_sellable" type="measure"/>
                <field name="quantity_reserved" type="measure"/>
                <field name="quantity_inbound_total" type="measure"/>
                <field name="quantity_unfulfillable" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="amazon_fba_inventory_view_search" model="ir.ui.view">
        <field name="name">amazon.fba.inventory.search</field>
        <field name="model">amazon.fba.inventory</field>
        <field name="arch" type="xml">
            <search string="Search Inventory">
                <field name="product_id"/>
                <field name="amazon_sku"/>
                <field name="amazon_asin"/>
                <field name="marketplace_id"/>
                <field name="account_id"/>
                <separator/>
                <filter name="filter_out_of_stock" string="Out of Stock" domain="[('quantity_sellable', '=', 0)]"/>
                <filter name="filter_low_stock" string="Needs Restock" domain="[('needs_restock', '=', True)]"/>
                <filter name="filter_in_stock" string="In Stock" domain="[('quantity_sellable', '>', 0)]"/>
                <separator/>
                <filter name="filter_unfulfillable" string="Has Unfulfillable" domain="[('quantity_unfulfillable', '>', 0)]"/>
                <filter name="filter_has_inbound" string="Has Inbound" domain="[('quantity_inbound_total', '>', 0)]"/>
                <filter name="filter_stranded" string="Stranded" domain="[('is_stranded', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_marketplace" string="Marketplace" context="{'group_by': 'marketplace_id'}"/>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="amazon_fba_inventory_action" model="ir.actions.act_window">
        <field name="name">FBA Inventory</field>
        <field name="res_model">amazon.fba.inventory</field>
        <field name="view_mode">tree,kanban,form,graph,pivot</field>
        <field name="search_view_id" ref="amazon_fba_inventory_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No FBA inventory data yet
            </p>
            <p>
                FBA inventory levels will appear here once you sync them from Amazon.
            </p>
        </field>
    </record>

    <!-- Action: Needs Restock -->
    <record id="amazon_fba_inventory_action_restock" model="ir.actions.act_window">
        <field name="name">Needs Restock</field>
        <field name="res_model">amazon.fba.inventory</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="amazon_fba_inventory_view_search"/>
        <field name="domain">[('needs_restock', '=', True)]</field>
    </record>

    <!-- Action: Out of Stock -->
    <record id="amazon_fba_inventory_action_out_of_stock" model="ir.actions.act_window">
        <field name="name">Out of Stock</field>
        <field name="res_model">amazon.fba.inventory</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="amazon_fba_inventory_view_search"/>
        <field name="domain">[('quantity_sellable', '=', 0)]</field>
    </record>
</odoo>
