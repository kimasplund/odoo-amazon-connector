<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Amazon Marketplace Views                                      -->
    <!-- ============================================================ -->

    <!-- Tree View -->
    <record id="amazon_marketplace_view_tree" model="ir.ui.view">
        <field name="name">amazon.marketplace.tree</field>
        <field name="model">amazon.marketplace</field>
        <field name="arch" type="xml">
            <list string="Amazon Marketplaces" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="marketplace_id"/>
                <field name="country_id"/>
                <field name="marketplace_id"/>
                <field name="currency_id"/>
                <field name="region"/>
                <field name="endpoint"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="amazon_marketplace_view_form" model="ir.ui.view">
        <field name="name">amazon.marketplace.form</field>
        <field name="model">amazon.marketplace</field>
        <field name="arch" type="xml">
            <form string="Amazon Marketplace">
                <header>
                    <button name="action_test_connection" 
                            string="Test Connection" 
                            type="object" 
                            class="btn-primary"
                            icon="fa-plug"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_accounts" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-users">
                            <field name="account_count" widget="statinfo" string="Accounts"/>
                        </button>
                        <button name="action_view_products" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                        <button name="action_view_orders" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Marketplace Name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Amazon Germany"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Marketplace Information">
                            <field name="marketplace_id"/>
                            <field name="marketplace_id" placeholder="e.g., A1PA6795UKMFR9"/>
                            <field name="country_id" options="{'no_create': True}"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Technical Configuration">
                            <field name="region" widget="selection"/>
                            <field name="endpoint"/>
                            <field name="sandbox_endpoint"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Settings" name="settings">
                            <group>
                                <group string="Sync Settings">
                                    <field name="auto_sync_products"/>
                                    <field name="auto_sync_orders"/>
                                    <field name="auto_sync_inventory"/>
                                    <field name="sync_interval" invisible="not auto_sync_orders"/>
                                </group>
                                <group string="Tax Configuration">
                                    <field name="default_tax_id"/>
                                    <field name="vat_rate"/>
                                    <field name="vat_included"/>
                                </group>
                            </group>
                        </page>
                        <page string="FBA Settings" name="fba">
                            <group>
                                <group string="FBA Configuration">
                                    <field name="fba_enabled"/>
                                    <field name="fba_warehouse_id" invisible="not fba_enabled"/>
                                    <field name="fba_location_id" invisible="not fba_enabled"/>
                                </group>
                                <group string="FBA Defaults">
                                    <field name="default_prep_owner" invisible="not fba_enabled"/>
                                    <field name="default_labeling_owner" invisible="not fba_enabled"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes about this marketplace..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="amazon_marketplace_view_kanban" model="ir.ui.view">
        <field name="name">amazon.marketplace.kanban</field>
        <field name="model">amazon.marketplace</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="marketplace_id"/>
                <field name="country_id"/>
                <field name="currency_id"/>
                <field name="active"/>
                <field name="order_count"/>
                <field name="product_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center mb-2">
                            <field name="country_id" widget="image" class="o_kanban_image rounded-circle" options="{'size': [48, 48]}"/>
                            <div class="ms-3">
                                <strong class="o_kanban_record_title fs-5">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    <field name="marketplace_id"/> - <field name="currency_id"/>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-6 text-center">
                                <span class="fw-bold text-primary"><field name="product_count"/></span>
                                <div class="text-muted small">Products</div>
                            </div>
                            <div class="col-6 text-center">
                                <span class="fw-bold text-success"><field name="order_count"/></span>
                                <div class="text-muted small">Orders</div>
                            </div>
                        </div>
                        <div class="mt-2" t-if="!record.active.raw_value">
                            <span class="badge text-bg-danger">Archived</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="amazon_marketplace_view_search" model="ir.ui.view">
        <field name="name">amazon.marketplace.search</field>
        <field name="model">amazon.marketplace</field>
        <field name="arch" type="xml">
            <search string="Search Marketplaces">
                <field name="name"/>
                <field name="marketplace_id"/>
                <field name="country_id"/>
                <field name="marketplace_id"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_europe" string="Europe" domain="[('region', '=', 'eu')]"/>
                <filter name="filter_north_america" string="North America" domain="[('region', '=', 'na')]"/>
                <filter name="filter_far_east" string="Far East" domain="[('region', '=', 'fe')]"/>
                <separator/>
                <filter name="filter_fba_enabled" string="FBA Enabled" domain="[('fba_enabled', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_region" string="Region" context="{'group_by': 'region'}"/>
                    <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="amazon_marketplace_action" model="ir.actions.act_window">
        <field name="name">Marketplaces</field>
        <field name="res_model">amazon.marketplace</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="amazon_marketplace_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Amazon Marketplace
            </p>
            <p>
                Configure the Amazon marketplaces where you sell. Each marketplace 
                represents a specific Amazon region (DE, UK, FR, etc.).
            </p>
        </field>
    </record>

</odoo>
