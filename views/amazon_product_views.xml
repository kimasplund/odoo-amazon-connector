<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Amazon Product Listing Views                                  -->
    <!-- ============================================================ -->

    <!-- Tree View -->
    <record id="amazon_product_listing_view_tree" model="ir.ui.view">
        <field name="name">amazon.product.listing.tree</field>
        <field name="model">amazon.product.listing</field>
        <field name="arch" type="xml">
            <list string="Amazon Listings" 
                  decoration-danger="state == 'inactive'" 
                  decoration-warning="state == 'suppressed'"
                  decoration-muted="state == 'error'"
                  sample="1">
                <field name="product_tmpl_id" widget="many2one_avatar"/>
                <field name="sku"/>
                <field name="asin"/>
                <field name="marketplace_id"/>
                <field name="account_id"/>
                <field name="title" optional="show"/>
                <field name="list_price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="quantity_available"/>
                <field name="fulfillment_channel" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'suppressed'"
                       decoration-danger="state in ['inactive', 'error']"/>
                <field name="is_buybox_winner" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="amazon_product_listing_view_form" model="ir.ui.view">
        <field name="name">amazon.product.listing.form</field>
        <field name="model">amazon.product.listing</field>
        <field name="arch" type="xml">
            <form string="Amazon Product Listing">
                <header>
                    <button name="action_sync_from_amazon" 
                            string="Sync from Amazon" 
                            type="object" 
                            class="btn-primary"
                            icon="fa-cloud-download"/>
                    <button name="action_push_to_amazon" 
                            string="Push to Amazon" 
                            type="object" 
                            class="btn-secondary"
                            icon="fa-cloud-upload"/>
                    <button name="action_update_price" 
                            string="Update Price" 
                            type="object"
                            icon="fa-dollar"/>
                    <button name="action_sync_inventory" 
                            string="Sync Inventory" 
                            type="object"
                            icon="fa-cubes"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_on_amazon" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-external-link"
                                string="View on Amazon"/>
                    </div>
                    <widget name="web_ribbon" title="Suppressed" bg_color="text-bg-warning" invisible="state != 'suppressed'"/>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="state != 'inactive'"/>
                    <div class="oe_title">
                        <label for="title" string="Listing Title"/>
                        <h1>
                            <field name="title" placeholder="Amazon listing title"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="product_tmpl_id" options="{'no_open': True}"/>
                        </h4>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="sku"/>
                            <field name="asin"/>
                            <field name="ean"/>
                            <field name="upc"/>
                            <field name="fnsku" invisible="fulfillment_channel != 'FBA'"/>
                        </group>
                        <group string="Marketplace">
                            <field name="account_id"/>
                            <field name="marketplace_id"/>
                            <field name="fulfillment_channel" widget="radio"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pricing" name="pricing">
                            <group>
                                <group string="Current Pricing">
                                    <field name="list_price" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="sale_price" widget="monetary"/>
                                    <field name="sale_price_start"/>
                                    <field name="sale_price_end"/>
                                    <field name="is_on_sale" readonly="1"/>
                                </group>
                                <group string="Competitive Info">
                                    <field name="buybox_price" widget="monetary"/>
                                    <field name="is_buybox_winner"/>
                                </group>
                            </group>
                            <group>
                                <group string="Price Limits">
                                    <field name="minimum_price" widget="monetary"/>
                                    <field name="maximum_price" widget="monetary"/>
                                </group>
                                <group string="Cost &amp; Margin">
                                    <field name="landed_cost" widget="monetary"/>
                                    <field name="profit_margin" widget="percentage"/>
                                </group>
                            </group>
                        </page>
                        <page string="Inventory" name="inventory">
                            <group>
                                <group string="Stock Levels">
                                    <field name="quantity_available"/>
                                    <field name="quantity_reserved"/>
                                    <field name="quantity_inbound" invisible="fulfillment_channel != 'FBA'"/>
                                    <field name="quantity_unfulfillable" invisible="fulfillment_channel != 'FBA'"/>
                                    <field name="total_fba_quantity" invisible="fulfillment_channel != 'FBA'"/>
                                </group>
                                <group string="Restock">
                                    <field name="restock_recommended"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert" invisible="fulfillment_channel != 'FBA'">
                                <i class="fa fa-info-circle"/> FBA inventory is managed by Amazon. 
                                Quantities shown are from Amazon's fulfillment centers.
                            </div>
                        </page>
                        <page string="Content" name="content">
                            <group>
                                <group string="Product Details">
                                    <field name="brand"/>
                                    <field name="manufacturer"/>
                                    <field name="amazon_category_id"/>
                                </group>
                                <group string="Category">
                                    <field name="browse_node_id"/>
                                    <field name="browse_node_path"/>
                                    <field name="item_type_keyword"/>
                                </group>
                            </group>
                            <group string="Bullet Points">
                                <field name="bullet_point_1" placeholder="Key feature 1"/>
                                <field name="bullet_point_2" placeholder="Key feature 2"/>
                                <field name="bullet_point_3" placeholder="Key feature 3"/>
                                <field name="bullet_point_4" placeholder="Key feature 4"/>
                                <field name="bullet_point_5" placeholder="Key feature 5"/>
                            </group>
                            <group string="Description">
                                <field name="description" nolabel="1" placeholder="Full product description..."/>
                            </group>
                            <group string="Search Terms">
                                <field name="search_terms" nolabel="1" placeholder="comma, separated, keywords"/>
                            </group>
                        </page>
                        <page string="Images" name="images">
                            <group>
                                <field name="main_image_url"/>
                                <field name="image_urls" placeholder="Additional image URLs (JSON list)"/>
                            </group>
                        </page>
                        <page string="Quality" name="quality">
                            <group>
                                <group string="Listing Quality">
                                    <field name="listing_quality_score"/>
                                    <field name="listing_issues"/>
                                </group>
                                <group string="Metrics">
                                    <field name="sales_rank"/>
                                    <field name="review_count"/>
                                    <field name="average_rating"/>
                                </group>
                            </group>
                        </page>
                        <page string="FBA" name="fba" invisible="fulfillment_channel != 'FBA'">
                            <group>
                                <group string="FBA Details">
                                    <field name="fnsku"/>
                                    <field name="fba_inbound_guidance"/>
                                </group>
                                <group string="FBA Fees">
                                    <field name="fba_fee" widget="monetary"/>
                                    <field name="referral_fee_percent"/>
                                    <field name="closing_fee" widget="monetary"/>
                                    <field name="estimated_total_fees" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                        <page string="Sync" name="sync">
                            <group>
                                <group string="Sync Status">
                                    <field name="last_sync_date"/>
                                    <field name="last_price_sync"/>
                                    <field name="last_inventory_sync"/>
                                    <field name="amazon_created_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="amazon_product_listing_view_kanban" model="ir.ui.view">
        <field name="name">amazon.product.listing.kanban</field>
        <field name="model">amazon.product.listing</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" default_group_by="state">
                <field name="title"/>
                <field name="sku"/>
                <field name="asin"/>
                <field name="list_price"/>
                <field name="currency_id"/>
                <field name="quantity_available"/>
                <field name="state"/>
                <field name="fulfillment_channel"/>
                <field name="is_buybox_winner"/>
                <progressbar field="state" colors='{"active": "success", "inactive": "danger", "suppressed": "warning", "draft": "muted"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between">
                                <strong class="o_kanban_record_title text-truncate" style="max-width: 200px;">
                                    <field name="title"/>
                                </strong>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'active'"
                                       decoration-warning="state == 'suppressed'"
                                       decoration-danger="state in ['inactive', 'error']"/>
                            </div>
                            <div class="text-muted small">
                                SKU: <field name="sku"/> | ASIN: <field name="asin"/>
                            </div>
                            <div class="mt-2 d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-primary">
                                    <field name="list_price" widget="monetary"/>
                                </span>
                                <span class="badge" t-att-class="record.fulfillment_channel.raw_value == 'FBA' ? 'text-bg-info' : 'text-bg-secondary'">
                                    <field name="fulfillment_channel"/>
                                </span>
                            </div>
                            <div class="mt-1 d-flex justify-content-between">
                                <span class="text-muted">
                                    <i class="fa fa-cubes"/> <field name="quantity_available"/> in stock
                                </span>
                                <span t-if="record.is_buybox_winner.raw_value" class="text-success">
                                    <i class="fa fa-trophy"/> Buy Box
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="amazon_product_listing_view_search" model="ir.ui.view">
        <field name="name">amazon.product.listing.search</field>
        <field name="model">amazon.product.listing</field>
        <field name="arch" type="xml">
            <search string="Search Amazon Listings">
                <field name="title"/>
                <field name="sku"/>
                <field name="asin"/>
                <field name="product_tmpl_id"/>
                <field name="account_id"/>
                <field name="marketplace_id"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('state', '=', 'inactive')]"/>
                <filter name="filter_suppressed" string="Suppressed" domain="[('state', '=', 'suppressed')]"/>
                <separator/>
                <filter name="filter_fba" string="FBA" domain="[('fulfillment_channel', '=', 'FBA')]"/>
                <filter name="filter_fbm" string="FBM" domain="[('fulfillment_channel', '=', 'FBM')]"/>
                <separator/>
                <filter name="filter_buy_box" string="Buy Box Winners" domain="[('is_buybox_winner', '=', True)]"/>
                <filter name="filter_no_buy_box" string="Lost Buy Box" domain="[('is_buybox_winner', '=', False), ('state', '=', 'active')]"/>
                <separator/>
                <filter name="filter_low_stock" string="Low Stock" domain="[('quantity_available', '&lt;', 5)]"/>
                <filter name="filter_out_of_stock" string="Out of Stock" domain="[('quantity_available', '=', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_marketplace" string="Marketplace" context="{'group_by': 'marketplace_id'}"/>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_fulfillment" string="Fulfillment" context="{'group_by': 'fulfillment_channel'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="amazon_product_listing_action" model="ir.actions.act_window">
        <field name="name">Product Listings</field>
        <field name="res_model">amazon.product.listing</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="amazon_product_listing_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Amazon listing
            </p>
            <p>
                Manage your Amazon product listings. Link Odoo products to their 
                Amazon counterparts and keep pricing, inventory, and content in sync.
            </p>
        </field>
    </record>

</odoo>
