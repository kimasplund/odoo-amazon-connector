<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Amazon FBA Shipment Views                                     -->
    <!-- ============================================================ -->

    <!-- Tree View -->
    <record id="amazon_fba_shipment_view_tree" model="ir.ui.view">
        <field name="name">amazon.fba.shipment.tree</field>
        <field name="model">amazon.fba.shipment</field>
        <field name="arch" type="xml">
            <list string="FBA Shipments" 
                  decoration-info="state == 'working'"
                  decoration-warning="state == 'shipped'"
                  decoration-success="state in ['receiving', 'closed']"
                  decoration-muted="state == 'canceled'"
                  sample="1">
                <field name="name"/>
                <field name="amazon_shipment_id"/>
                <field name="account_id"/>
                <field name="marketplace_id"/>
                <field name="destination_fc_id"/>
                <field name="label_prep_type"/>
                <field name="item_count"/>
                <field name="total_quantity"/>
                <field name="ship_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'working'"
                       decoration-warning="state == 'shipped'"
                       decoration-success="state in ['receiving', 'closed']"
                       decoration-muted="state == 'canceled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="amazon_fba_shipment_view_form" model="ir.ui.view">
        <field name="name">amazon.fba.shipment.form</field>
        <field name="model">amazon.fba.shipment</field>
        <field name="arch" type="xml">
            <form string="FBA Shipment">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,working,shipped,receiving,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_items" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-cubes">
                            <field name="item_count" widget="statinfo" string="Items"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Canceled" bg_color="text-bg-danger" invisible="state != 'canceled'"/>
                    <div class="oe_title">
                        <label for="name" string="Shipment Name"/>
                        <h1>
                            <field name="name" placeholder="e.g., FBA-001"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Shipment Info">
                            <field name="amazon_shipment_id"/>
                            <field name="amazon_shipment_name"/>
                            <field name="account_id"/>
                            <field name="marketplace_id"/>
                            <field name="shipment_type"/>
                            <field name="destination_fc_id"/>
                            <field name="destination_country_id"/>
                        </group>
                        <group string="Preparation">
                            <field name="label_prep_type"/>
                            <field name="packing_type"/>
                            <field name="warehouse_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="item_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_name"/>
                                    <field name="amazon_sku"/>
                                    <field name="amazon_fnsku"/>
                                    <field name="amazon_asin" optional="hide"/>
                                    <field name="quantity"/>
                                    <field name="received_quantity" readonly="1"/>
                                    <field name="quantity_in_case" optional="show"/>
                                    <field name="label_owner" optional="show"/>
                                    <field name="prep_owner" optional="show"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_quantity" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Shipping" name="shipping">
                            <group>
                                <group string="Carrier Information">
                                    <field name="carrier_id"/>
                                    <field name="carrier_name"/>
                                    <field name="pro_number"/>
                                    <field name="tracking_numbers"/>
                                </group>
                                <group string="Dates">
                                    <field name="ship_date"/>
                                    <field name="estimated_arrival_date"/>
                                    <field name="actual_arrival_date"/>
                                    <field name="closed_date"/>
                                </group>
                            </group>
                            <group string="Quantities">
                                <group>
                                    <field name="total_quantity"/>
                                    <field name="received_quantity"/>
                                    <field name="quantity_difference"/>
                                </group>
                                <group>
                                    <field name="box_count"/>
                                    <field name="total_weight"/>
                                    <field name="total_volume"/>
                                </group>
                            </group>
                            <group string="Fees">
                                <field name="estimated_fee" widget="monetary"/>
                                <field name="actual_fee" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Amazon Status" name="amazon_status">
                            <group>
                                <group>
                                    <field name="amazon_status"/>
                                    <field name="inbound_plan_id"/>
                                    <field name="last_sync_date"/>
                                    <field name="sync_error"/>
                                </group>
                            </group>
                            <group string="Amazon Notes">
                                <field name="amazon_notes" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="amazon_fba_shipment_view_kanban" model="ir.ui.view">
        <field name="name">amazon.fba.shipment.kanban</field>
        <field name="model">amazon.fba.shipment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" default_group_by="state">
                <field name="name"/>
                <field name="amazon_shipment_id"/>
                <field name="state"/>
                <field name="item_count"/>
                <field name="total_quantity"/>
                <field name="destination_fc_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'working'"
                                       decoration-warning="state == 'shipped'"
                                       decoration-success="state in ['receiving', 'closed']"
                                       decoration-danger="state == 'canceled'"/>
                            </div>
                            <div class="text-muted small mb-2">
                                <field name="amazon_shipment_id"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span><i class="fa fa-cubes"/> <field name="item_count"/> items</span>
                                <span><i class="fa fa-archive"/> <field name="total_quantity"/> units</span>
                            </div>
                            <div class="text-muted small mt-2">
                                <i class="fa fa-building"/> <field name="destination_fc_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="amazon_fba_shipment_view_search" model="ir.ui.view">
        <field name="name">amazon.fba.shipment.search</field>
        <field name="model">amazon.fba.shipment</field>
        <field name="arch" type="xml">
            <search string="Search FBA Shipments">
                <field name="name"/>
                <field name="amazon_shipment_id"/>
                <field name="account_id"/>
                <field name="marketplace_id"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_working" string="Working" domain="[('state', '=', 'working')]"/>
                <filter name="filter_shipped" string="Shipped" domain="[('state', '=', 'shipped')]"/>
                <filter name="filter_receiving" string="Receiving" domain="[('state', '=', 'receiving')]"/>
                <filter name="filter_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('state', 'not in', ['canceled', 'closed'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_marketplace" string="Marketplace" context="{'group_by': 'marketplace_id'}"/>
                    <filter name="group_fc" string="Fulfillment Center" context="{'group_by': 'destination_fc_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="amazon_fba_shipment_action" model="ir.actions.act_window">
        <field name="name">FBA Shipments</field>
        <field name="res_model">amazon.fba.shipment</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="amazon_fba_shipment_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first FBA shipment
            </p>
            <p>
                Send inventory to Amazon FBA fulfillment centers.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Amazon FBA Shipment Item Views                                -->
    <!-- ============================================================ -->

    <record id="amazon_fba_shipment_item_view_tree" model="ir.ui.view">
        <field name="name">amazon.fba.shipment.item.tree</field>
        <field name="model">amazon.fba.shipment.item</field>
        <field name="arch" type="xml">
            <list string="Shipment Items">
                <field name="shipment_id"/>
                <field name="product_id"/>
                <field name="product_name"/>
                <field name="amazon_sku"/>
                <field name="amazon_fnsku"/>
                <field name="amazon_asin" optional="hide"/>
                <field name="quantity"/>
                <field name="received_quantity"/>
                <field name="quantity_difference"/>
                <field name="condition"/>
                <field name="shipment_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="amazon_fba_shipment_item_view_search" model="ir.ui.view">
        <field name="name">amazon.fba.shipment.item.search</field>
        <field name="model">amazon.fba.shipment.item</field>
        <field name="arch" type="xml">
            <search string="Search Shipment Items">
                <field name="product_id"/>
                <field name="amazon_sku"/>
                <field name="amazon_fnsku"/>
                <field name="shipment_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_shipment" string="Shipment" context="{'group_by': 'shipment_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="amazon_fba_shipment_item_action" model="ir.actions.act_window">
        <field name="name">Shipment Items</field>
        <field name="res_model">amazon.fba.shipment.item</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="amazon_fba_shipment_item_view_search"/>
    </record>
</odoo>
