<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Amazon Order Views                                            -->
    <!-- ============================================================ -->

    <!-- Tree View -->
    <record id="amazon_order_view_tree" model="ir.ui.view">
        <field name="name">amazon.order.tree</field>
        <field name="model">amazon.order</field>
        <field name="arch" type="xml">
            <list string="Amazon Orders" 
                  decoration-info="state == 'pending'"
                  decoration-success="state == 'shipped'"
                  decoration-muted="state == 'canceled'"
                  sample="1">
                <field name="amazon_order_id"/>
                <field name="purchase_date"/>
                <field name="sale_order_id" optional="show"/>
                <field name="marketplace_id"/>
                <field name="buyer_name" optional="show"/>
                <field name="fulfillment_channel" widget="badge"/>
                <field name="order_total" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="items_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state == 'unshipped'"
                       decoration-success="state == 'shipped'"
                       decoration-muted="state == 'canceled'"/>
                <field name="is_business_order" widget="boolean" optional="hide"/>
                <field name="is_prime" widget="boolean" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="amazon_order_view_form" model="ir.ui.view">
        <field name="name">amazon.order.form</field>
        <field name="model">amazon.order</field>
        <field name="arch" type="xml">
            <form string="Amazon Order">
                <header>
                    <button name="action_create_sale_order" 
                            string="Create Sale Order" 
                            type="object" 
                            class="btn-primary"
                            invisible="sale_order_id or state == 'canceled'"
                            icon="fa-file-text-o"/>
                    <button name="action_confirm_shipment" 
                            string="Confirm Shipment" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'unshipped' or fulfillment_channel == 'FBA'"
                            icon="fa-truck"/>
                    <button name="action_sync_order" 
                            string="Sync from Amazon" 
                            type="object" 
                            class="btn-secondary"
                            icon="fa-refresh"/>
                    <button name="action_cancel_order" 
                            string="Cancel" 
                            type="object" 
                            class="btn-secondary"
                            invisible="state in ['shipped', 'canceled']"
                            confirm="Are you sure you want to cancel this order?"
                            icon="fa-times"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,unshipped,shipped"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sale Order</span>
                                <span class="o_stat_value"><field name="sale_order_id" readonly="1"/></span>
                            </div>
                        </button>
                        <button name="action_view_picking" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-truck"
                                invisible="not picking_ids">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                        <button name="action_view_invoice" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-money"
                                invisible="not invoice_ids">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_returns" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-undo"
                                invisible="not return_count">
                            <field name="return_count" widget="statinfo" string="Returns"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Canceled" bg_color="text-bg-danger" invisible="state != 'canceled'"/>
                    <widget name="web_ribbon" title="Prime" bg_color="text-bg-primary" invisible="not is_prime"/>
                    <div class="oe_title">
                        <label for="amazon_order_id" string="Amazon Order"/>
                        <h1>
                            <field name="amazon_order_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Order Information">
                            <field name="purchase_date"/>
                            <field name="last_update_date"/>
                            <field name="marketplace_id"/>
                            <field name="account_id"/>
                            <field name="fulfillment_channel"/>
                            <field name="order_type"/>
                        </group>
                        <group string="Amounts">
                            <field name="order_total" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="shipping_price" widget="monetary"/>
                            <field name="tax_amount" widget="monetary"/>
                            <field name="items_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="lines">
                            <field name="order_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="amazon_order_item_id"/>
                                    <field name="listing_id"/>
                                    <field name="product_id"/>
                                    <field name="sku"/>
                                    <field name="asin"/>
                                    <field name="title"/>
                                    <field name="quantity"/>
                                    <field name="item_price" widget="monetary"/>
                                    <field name="shipping_price" widget="monetary"/>
                                    <field name="tax_amount" widget="monetary" optional="hide"/>
                                    <field name="item_status" widget="badge"
                                           decoration-success="item_status == 'Shipped'"
                                           decoration-info="item_status == 'Unshipped'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Buyer Information" name="buyer">
                            <group>
                                <group string="Buyer Details">
                                    <field name="buyer_name"/>
                                    <field name="buyer_email"/>
                                    <field name="partner_id"/>
                                    <field name="is_business_order"/>
                                    <field name="purchase_order_number" invisible="not is_business_order"/>
                                </group>
                                <group string="Shipping Address">
                                    <field name="ship_name"/>
                                    <field name="ship_address_1"/>
                                    <field name="ship_address_2"/>
                                    <field name="ship_city"/>
                                    <field name="ship_state"/>
                                    <field name="ship_postal_code"/>
                                    <field name="ship_country_id"/>
                                    <field name="ship_phone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Shipping" name="shipping">
                            <group>
                                <group string="Shipping Details">
                                    <field name="ship_service_level"/>
                                    <field name="ship_service_category"/>
                                    <field name="earliest_ship_date"/>
                                    <field name="latest_ship_date"/>
                                    <field name="earliest_delivery_date"/>
                                    <field name="latest_delivery_date"/>
                                </group>
                                <group string="Fulfillment" invisible="fulfillment_channel != 'FBA'">
                                    <field name="fulfillment_center"/>
                                    <field name="amazon_shipment_id"/>
                                </group>
                            </group>
                            <group string="Tracking Information" invisible="fulfillment_channel == 'FBA'">
                                <field name="carrier_code"/>
                                <field name="carrier_name"/>
                                <field name="tracking_number"/>
                                <field name="ship_date"/>
                            </group>
                        </page>
                        <page string="Gift Options" name="gift" invisible="not is_gift">
                            <group>
                                <group>
                                    <field name="is_gift"/>
                                    <field name="gift_message"/>
                                    <field name="gift_wrap_type"/>
                                    <field name="gift_wrap_price" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                        <page string="Additional Info" name="additional">
                            <group>
                                <group string="Order Flags">
                                    <field name="is_prime"/>
                                    <field name="is_premium"/>
                                    <field name="is_replacement"/>
                                    <field name="is_sold_by_ab"/>
                                </group>
                                <group string="Payment">
                                    <field name="payment_method"/>
                                    <field name="payment_method_details"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="notes" nolabel="1" placeholder="Internal notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="amazon_order_view_kanban" model="ir.ui.view">
        <field name="name">amazon.order.kanban</field>
        <field name="model">amazon.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" default_group_by="state">
                <field name="amazon_order_id"/>
                <field name="purchase_date"/>
                <field name="buyer_name"/>
                <field name="order_total"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="fulfillment_channel"/>
                <field name="items_count"/>
                <field name="is_prime"/>
                <field name="is_business_order"/>
                <progressbar field="state" colors='{"pending": "info", "unshipped": "warning", "shipped": "success", "canceled": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong class="o_kanban_record_title">
                                        <field name="amazon_order_id"/>
                                    </strong>
                                    <span t-if="record.is_prime.raw_value" class="badge text-bg-primary ms-1">Prime</span>
                                    <span t-if="record.is_business_order.raw_value" class="badge text-bg-secondary ms-1">B2B</span>
                                </div>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'pending'"
                                       decoration-warning="state == 'unshipped'"
                                       decoration-success="state == 'shipped'"
                                       decoration-danger="state == 'canceled'"/>
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fa fa-calendar-o"/> <field name="purchase_date" widget="date"/>
                            </div>
                            <div class="mb-2">
                                <i class="fa fa-user"/> <field name="buyer_name"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-end">
                                <span class="fw-bold fs-5 text-primary">
                                    <field name="order_total" widget="monetary"/>
                                </span>
                                <span class="badge" t-att-class="record.fulfillment_channel.raw_value == 'FBA' ? 'text-bg-info' : 'text-bg-secondary'">
                                    <field name="fulfillment_channel"/>
                                </span>
                            </div>
                            <div class="text-muted small mt-1">
                                <field name="items_count"/> item(s)
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="amazon_order_view_calendar" model="ir.ui.view">
        <field name="name">amazon.order.calendar</field>
        <field name="model">amazon.order</field>
        <field name="arch" type="xml">
            <calendar string="Amazon Orders" date_start="purchase_date" color="state" mode="month" quick_create="0">
                <field name="amazon_order_id"/>
                <field name="buyer_name"/>
                <field name="order_total"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Graph View -->
    <record id="amazon_order_view_graph" model="ir.ui.view">
        <field name="name">amazon.order.graph</field>
        <field name="model">amazon.order</field>
        <field name="arch" type="xml">
            <graph string="Amazon Orders" type="bar" sample="1">
                <field name="purchase_date" interval="day"/>
                <field name="order_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="amazon_order_view_pivot" model="ir.ui.view">
        <field name="name">amazon.order.pivot</field>
        <field name="model">amazon.order</field>
        <field name="arch" type="xml">
            <pivot string="Amazon Orders" sample="1">
                <field name="marketplace_id" type="row"/>
                <field name="purchase_date" interval="month" type="col"/>
                <field name="order_total" type="measure"/>
                <field name="items_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="amazon_order_view_search" model="ir.ui.view">
        <field name="name">amazon.order.search</field>
        <field name="model">amazon.order</field>
        <field name="arch" type="xml">
            <search string="Search Amazon Orders">
                <field name="amazon_order_id"/>
                <field name="buyer_name"/>
                <field name="buyer_email"/>
                <field name="sale_order_id"/>
                <field name="marketplace_id"/>
                <field name="account_id"/>
                <separator/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_unshipped" string="Unshipped" domain="[('state', '=', 'unshipped')]"/>
                <filter name="filter_shipped" string="Shipped" domain="[('state', '=', 'shipped')]"/>
                <filter name="filter_canceled" string="Canceled" domain="[('state', '=', 'canceled')]"/>
                <separator/>
                <filter name="filter_fba" string="FBA" domain="[('fulfillment_channel', '=', 'FBA')]"/>
                <filter name="filter_fbm" string="FBM" domain="[('fulfillment_channel', '=', 'FBM')]"/>
                <separator/>
                <filter name="filter_prime" string="Prime" domain="[('is_prime', '=', True)]"/>
                <filter name="filter_business" string="Business (B2B)" domain="[('is_business_order', '=', True)]"/>
                <filter name="filter_gift" string="Gift Orders" domain="[('is_gift', '=', True)]"/>
                <separator/>
                <filter name="filter_today" string="Today" domain="[('purchase_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="filter_week" string="This Week" domain="[('purchase_date', '>=', (context_today() - datetime.timedelta(days=7)))]"/>
                <filter name="filter_month" string="This Month" domain="[('purchase_date', '>=', (context_today().replace(day=1)))]"/>
                <separator/>
                <filter name="filter_no_sale_order" string="No Sale Order" domain="[('sale_order_id', '=', False), ('state', '!=', 'canceled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_marketplace" string="Marketplace" context="{'group_by': 'marketplace_id'}"/>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_fulfillment" string="Fulfillment" context="{'group_by': 'fulfillment_channel'}"/>
                    <filter name="group_date" string="Order Date" context="{'group_by': 'purchase_date:day'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'purchase_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="amazon_order_action" model="ir.actions.act_window">
        <field name="name">Amazon Orders</field>
        <field name="res_model">amazon.order</field>
        <field name="view_mode">tree,kanban,form,calendar,graph,pivot</field>
        <field name="search_view_id" ref="amazon_order_view_search"/>
        <field name="context">{'search_default_filter_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Amazon orders yet
            </p>
            <p>
                Orders will appear here once you sync them from Amazon. 
                Configure your account and enable order sync to get started.
            </p>
        </field>
    </record>

    <!-- Action: Unshipped Orders -->
    <record id="amazon_order_action_unshipped" model="ir.actions.act_window">
        <field name="name">Unshipped Orders</field>
        <field name="res_model">amazon.order</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="amazon_order_view_search"/>
        <field name="domain">[('state', '=', 'unshipped'), ('fulfillment_channel', '=', 'FBM')]</field>
        <field name="context">{}</field>
    </record>

    <!-- ============================================================ -->
    <!-- Amazon Order Line Views                                       -->
    <!-- ============================================================ -->

    <record id="amazon_order_line_view_tree" model="ir.ui.view">
        <field name="name">amazon.order.line.tree</field>
        <field name="model">amazon.order.line</field>
        <field name="arch" type="xml">
            <list string="Order Lines" create="0">
                <field name="order_id"/>
                <field name="amazon_order_item_id"/>
                <field name="sku"/>
                <field name="asin"/>
                <field name="title"/>
                <field name="quantity"/>
                <field name="item_price" widget="monetary"/>
                <field name="item_status" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Amazon Return Views                                           -->
    <!-- ============================================================ -->

    <record id="amazon_return_view_tree" model="ir.ui.view">
        <field name="name">amazon.return.tree</field>
        <field name="model">amazon.return</field>
        <field name="arch" type="xml">
            <list string="Returns" decoration-warning="state == 'pending'" decoration-success="state == 'completed'">
                <field name="return_id"/>
                <field name="order_id"/>
                <field name="return_date"/>
                <field name="return_reason"/>
                <field name="return_type"/>
                <field name="refund_amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'canceled'"/>
            </list>
        </field>
    </record>

    <record id="amazon_return_view_form" model="ir.ui.view">
        <field name="name">amazon.return.form</field>
        <field name="model">amazon.return</field>
        <field name="arch" type="xml">
            <form string="Amazon Return">
                <header>
                    <button name="action_process_return" 
                            string="Process Return" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_issue_refund" 
                            string="Issue Refund" 
                            type="object" 
                            class="btn-secondary"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,completed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Return Details">
                            <field name="return_id"/>
                            <field name="order_id"/>
                            <field name="return_date"/>
                            <field name="return_reason"/>
                            <field name="return_sub_reason"/>
                        </group>
                        <group string="Resolution">
                            <field name="return_type"/>
                            <field name="refund_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="resolution_date"/>
                        </group>
                    </group>
                    <group string="Items">
                        <field name="return_line_ids" nolabel="1">
                            <list>
                                <field name="product_id"/>
                                <field name="sku"/>
                                <field name="quantity"/>
                                <field name="refund_amount" widget="monetary"/>
                            </list>
                        </field>
                    </group>
                    <group string="Comments">
                        <field name="buyer_comment" readonly="1"/>
                        <field name="seller_comment"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="amazon_return_view_search" model="ir.ui.view">
        <field name="name">amazon.return.search</field>
        <field name="model">amazon.return</field>
        <field name="arch" type="xml">
            <search string="Search Returns">
                <field name="return_id"/>
                <field name="order_id"/>
                <field name="return_reason"/>
                <separator/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_reason" string="Reason" context="{'group_by': 'return_reason'}"/>
                    <filter name="group_date" string="Return Date" context="{'group_by': 'return_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="amazon_return_action" model="ir.actions.act_window">
        <field name="name">Returns</field>
        <field name="res_model">amazon.return</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="amazon_return_view_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

</odoo>
